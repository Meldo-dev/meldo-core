    "Holt die Aufgaben aus deinen Teams-Klassen. Du schaltest es in den Einstellungen ein, wenn deine Schule es erlaubt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Holt die Aufgaben aus deinen Teams Klassen. Du schaltest es in den Einstellungen ein, wenn deine Schule es erlaubt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings in the assignments from your Teams classes. Turn it on in Settings if your school allows it."
          }
        }
      }
    },
    "Ohne Passwort sichert Meldo nichts. Hast du auf einem anderen Gerät schon ein Backup, nimm dasselbe Passwort.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Passwort synchronisiert Meldo nichts. Hast du den Sync auf einem anderen Gerät schon eingerichtet, nimm dasselbe Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a password, Meldo syncs nothing. If you already set up sync on another device, use the same password."
          }
        }
      }
    },
    "Passwort fehlt": {
      "localizations": {
