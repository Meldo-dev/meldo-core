    "Hi, ich bin Meldo! Lege deine Fächer und deinen Stundenplan an. Danach ordne ich jede Meldung automatisch der laufenden Stunde zu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, ich bin Meldo! Lege deine Fächer und deinen Stundenplan an. Danach ordne ich jede Meldung automatisch der laufenden Stunde zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, I'm Meldo! Add your subjects and your timetable. After that, I'll automatically assign each contribution to the lesson in progress."
