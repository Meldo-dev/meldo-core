      }
    },
    "Start und Stundenplan bleiben immer in der Leiste. Alles andere findest du unter Mehr.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start und Stundenplan bleiben immer in der Leiste. Alles andere findest du unter Mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home and Timetable always stay in the tab bar. Everything else is under More."
          }
        }
      }
    },
    "So, wie du es magst": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So, wie du es magst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just the way you like it"
          }
        }
      }
    },
    "Ein paar Einstellungen, damit Meldo zu dir passt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar Einstellungen, damit Meldo zu dir passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few settings so Meldo fits you."
          }
        }
      }
    },
    "Such dir aus, welche zwei Seiten neben Start und Stundenplan in der Leiste stehen und welche Seite Meldo beim Öffnen zeigt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such dir aus, welche zwei Seiten neben Start und Stundenplan in der Leiste stehen und welche Seite Meldo beim Öffnen zeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which two pages sit in the tab bar next to Home and Timetable, and which page Meldo shows when it opens."
          }
        }
      }
    },
    "Zeig auf der Startseite nur die Karten, die du brauchst, in deiner Reihenfolge.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeig auf der Startseite nur die Karten, die du brauchst, in deiner Reihenfolge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show only the cards you need on the start page, in your order."
          }
        }
      }
    },
    "Hell oder dunkel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hell oder dunkel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light or dark"
          }
        }
      }
    },
    "Meldo folgt deinem Gerät. In den Einstellungen kannst du auch immer hell oder immer dunkel wählen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo folgt deinem Gerät. In den Einstellungen kannst du auch immer hell oder immer dunkel wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo follows your device. In Settings you can also choose always light or always dark."
          }
        }
      }
    },
    "Ein verschlüsseltes Backup in deinem eigenen Google Drive, mit all deinen Einstellungen. Beim Einrichten legst du ein Backup Passwort fest; damit öffnest du es auch auf einem neuen Gerät.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselter Sync über dein eigenes Google Drive, mit all deinen Einstellungen. Beim Einrichten legst du ein Sync-Passwort fest; damit verbindest du auch ein neues Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted sync through your own Google Drive, with all your settings. When you set it up, you choose a sync password; you use it to connect a new device too."
          }
        }
      }
    },
    "Verantwortlich und Kontakt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verantwortlich und Kontakt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controller and contact"
          }
        }
      }
    },
    "Meldo wird von Yavuz Selim Kolbasar als kostenloses, nicht-kommerzielles Projekt entwickelt. Bei Fragen zum Datenschutz erreichst du den Entwickler unter contact@meldo.dev. Meldo ist Open Source: Den Quellcode kannst du auf GitHub selbst prüfen. Meldo ist kein Angebot von Untis, Microsoft oder Google und steht mit ihnen in keiner Verbindung.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo wird von Yavuz Selim Kolbasar als kostenloses, nicht-kommerzielles Projekt entwickelt. Bei Fragen zum Datenschutz erreichst du den Entwickler unter contact@meldo.dev. Meldo ist Open Source: Den Quellcode kannst du auf GitHub selbst prüfen. Meldo ist kein Angebot von Untis, Microsoft oder Google und steht mit ihnen in keiner Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo is developed by Yavuz Selim Kolbasar as a free, non-commercial project. For privacy questions, contact the developer at contact@meldo.dev. Meldo is open source, so you can check the code on GitHub yourself. Meldo is not offered by or affiliated with Untis, Microsoft or Google."
          }
        }
      }
    },
    "Rechtsgrundlage": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtsgrundlage"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legal basis"
          }
        }
      }
    },
    "Scannen, Fotos und Dateien": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen, Fotos und Dateien"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning, photos and files"
          }
        }
      }
    },
    "Zum Scannen nutzt Meldo den Dokumentenscanner von Apple. Die Seiten werden auf deinem Gerät erfasst und als PDF in Meldo gespeichert. Bei Fotos bekommt Meldo nur die Bilder, die du auswählst. PDFs wählst du in der Dateien-App aus. Dafür sendet Meldo keine Daten an einen Server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Scannen nutzt Meldo den Dokumentenscanner von Apple. Die Seiten werden auf deinem Gerät erfasst und als PDF in Meldo gespeichert. Bei Fotos bekommt Meldo nur die Bilder, die du auswählst. PDFs wählst du in der Dateien-App aus. Dafür sendet Meldo keine Daten an einen Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For scanning, Meldo uses Apple's document scanner. The pages are captured on your device and saved as a PDF in Meldo. For photos, Meldo only gets the pictures you pick. You choose PDFs in the Files app. Meldo sends no data to a server for this."
          }
        }
      }
    },
    "Widerspruchsrecht": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widerspruchsrecht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right to object"
          }
        }
      }
    },
    "Verarbeitet der Entwickler Daten nach Art. 6 Abs. 1 lit. f DSGVO (Absturzberichte, E-Mails), kannst du dem jederzeit widersprechen, per E-Mail an contact@meldo.dev.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verarbeitet der Entwickler Daten nach Art. 6 Abs. 1 lit. f DSGVO (Absturzberichte, E-Mails), kannst du dem jederzeit widersprechen, per E-Mail an contact@meldo.dev."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the developer processes data under Art. 6(1)(f) GDPR (crash reports, emails), you can object at any time by emailing contact@meldo.dev."
          }
        }
      }
    }
  },
  "version": "1.0"
}
